{
  "version": 1,
  "locals": {
    "USQL_PATH": "C:/path/to/usql.exe",
    "SOURCE_CODE_PATH": "D:/path/to/source-code-repo",
    "PRIMARY_BACKEND_SOURCE_ROOT": "D:/path/to/backend-repository",
    "PRIMARY_FRONTEND_SOURCE_ROOT": "D:/path/to/frontend-repository",
    "PRIMARY_OPENAPI_DOCUMENT_URL": "http://test.example.com/v3/api-docs",
    "SECONDARY_OPENAPI_DOCUMENT_URL": "http://test-secondary.example.com/v3/api-docs",
    "JAVA_PATH": "C:/path/to/java.exe",
    "KARATE_JAR_PATH": "C:/path/to/karate.jar",
    "LARK_CLI_PATH": "C:/path/to/lark-cli.cmd",
    "LARK_CLI_PROFILE": "default"
  },
  "secrets": {
    "DATABASE_PASSWORD": "replace-with-local-database-password",
    "PRIMARY_TEST_ADMIN_USERNAME": "replace-with-local-primary-test-admin-username",
    "PRIMARY_TEST_ADMIN_PASSWORD": "replace-with-local-primary-test-admin-password",
    "SECONDARY_OPENAPI_AUTHORIZATION": "Bearer replace-with-local-token",
    "LLM_API_KEY": "replace-with-local-llm-api-key"
  },
  "llm": {
    "provider": "openai-compatible",
    "model": "gpt-4.1-mini",
    "base_url": "https://llm-proxy.example.com/v1",
    "api_key": "${secret:LLM_API_KEY}"
  },
  "integrations": {
    "lark_cli": {
      "params": {
        "executable_path": "${local:LARK_CLI_PATH}",
        "profile": "${local:LARK_CLI_PROFILE}",
        "target_url": "https://example.feishu.cn/base/<base_token>?table=<table_id>&view=<view_id>"
      }
    }
  }
}
